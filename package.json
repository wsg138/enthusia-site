{
  "name": "enthusia-community-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:profile-exports": "python -m unittest discover -s tests/offline-profile -v",
    "build": "node scripts/build.mjs",
    "check": "node scripts/validate-site.mjs",
    "lint": "eslint . --ext .js,.mjs",
    "test:baseline": "node --test tests/site-baseline.test.mjs",
    "test:competitions": "node --test tests/competitions-*.test.mjs tests/gallery-*.test.mjs",
    "test:appeals": "node --test tests/appeal-*.test.mjs tests/punishment-site.test.mjs tests/site-community-navigation.test.mjs",
    "test:potions": "node --test tests/potion-preview.test.mjs",
    "test:wiki-worker": "node --test tests/wiki-worker-*.test.mjs",
    "mask-editor": "python scripts/cinematic-mask-editor.py",
    "validate:cinematic": "python scripts/generate-terrain-mask.py --validate-only",
    "test": "npm run lint && npm run check && node --test tests/*.test.mjs && node scripts/test-market-layers.mjs",
    "preview:build": "node scripts/build-preview-data.mjs && node scripts/build-integration-preview.mjs",
    "prebuild": "npm run preview:build"
  },
  "devDependencies": {
    "eslint": "8.57.1"
  }
}
